rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Seuls les comptes de l'équipe (liste d'identifiants générée au déploiement) accèdent aux données.
    // Les inscriptions sont de plus désactivées dans Firebase.
    function membre() {
      return request.auth != null && request.auth.uid in [__UIDS__];
    }

    // Fiche personnelle : chacun n'écrit que la sienne.
    match /team/{uid} {
      allow read: if membre();
      allow write: if membre() && request.auth.uid == uid;
    }

    // Jetons de notification : le compte ne peut enregistrer que ses propres appareils.
    match /devices/{token} {
      allow read, delete: if membre();
      allow create, update: if membre() && request.resource.data.uid == request.auth.uid;
    }

    // Photos : texte uniquement, taille bornée (anti-bourrage de la base).
    match /photos/{id} {
      allow read, delete: if membre();
      allow create, update: if membre()
        && request.resource.data.d is string
        && request.resource.data.d.size() < 900000;
    }

    // Clé de chiffrement des sauvegardes automatiques : lisible par l'équipe (pour déchiffrer),
    // jamais modifiable depuis l'appli. Seul le robot GitHub (SDK admin, hors règles) la crée.
    match /bkey/{id} {
      allow read: if membre();
      allow write: if false;
    }

    // Demandes de rangement par Claude : l'appli dépose une note « new » à son nom ; seul le robot GitHub
    // (SDK admin, hors règles) la passe à « done » ou « err ». L'appli ne peut donc ni rejouer ni falsifier un résultat.
    match /ia/{id} {
      allow read, delete: if membre();
      allow create: if membre()
        && request.resource.data.state == 'new'
        && request.resource.data.by == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() < 5000;
      allow update: if membre() && request.resource.data.state == resource.data.state;
    }

    // Journal (traces) : on peut seulement AJOUTER une trace à son propre nom ; jamais la modifier ni l'effacer.
    match /journal/{id} {
      allow read: if membre();
      allow create: if membre()
        && request.resource.data.by == request.auth.uid
        && request.resource.data.op in ['ajout', 'modif', 'suppr']
        && request.resource.data.col is string
        && request.resource.data.at is number;
      allow update, delete: if false;
    }

    // Compteurs de demandes à Claude (plafonds) : tenus par le robot seul, invisibles et intouchables depuis l'appli.
    match /iaq/{id} {
      allow read, write: if false;
    }

    // Données métier : liste blanche de collections ; tout le reste est refusé.
    match /{col}/{doc=**} {
      allow read, write: if membre() && col in [
        'clients', 'codes', 'docs', 'entries', 'ideas', 'items', 'locks',
        'meta', 'news', 'orders', 'outbox', 'rdv', 'vehicles'
      ];
    }
  }
}
